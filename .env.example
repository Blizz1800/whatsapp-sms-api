# DATABASE_URL=postgres://username:password@localhost:5432/database_name
# DB_TYPE=postgres|sqlite
# DATABASE_URL=file:///whatsapp.db

# Cleanup de mensajes huérfanos en forwardable_messages (safety net)
CLEANUP_INTERVAL_HOURS='24' # frecuencia del job de limpieza (horas)
MSG_RETENTION_DAYS='30'     # borrar mensajes protegidos con mas de N dias sin liberarse

# Puerta de envío y worker de jobs (gateway asíncrono)
SEND_RATE_PER_MINUTE='20'        # envíos por minuto (rate limit global)
SEND_TIMEOUT_SECONDS='15'        # timeout por destinatario (segundos)
MAX_SEND_ATTEMPTS='3'            # intentos de envío por job
RETRY_BACKOFF_SECONDS='30'       # base del backoff entre intentos (segundos)
RETRY_BACKOFF_MAX_SECONDS='300'  # tope del backoff (segundos)
JOB_POLL_INTERVAL_MS='500'       # intervalo de sondeo de jobs (ms)
JOB_STALE_SECONDS='300'          # considerar job running como obsoleto (segundos)
JOB_SWEEP_INTERVAL='60s'         # periodo de barrido de jobs obsoletos
SYNC_WAIT_SECONDS='30'           # espera sincrónica de /sendMessage (segundos)
UPDATES_BUFFER_SIZE='1000'       # tamaño del buffer de /getUpdates

DATABASE_URL=postgres://username:password@localhost:5432/database_name
DB_TYPE=postgres|sqlite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase